# ==============================================================================
# Environment Configuration Example for AURELIA ATELIER (Server)
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://aurelia_user:aurelia_secure_password@localhost:5432/aurelia_events?schema=public"

# Authentication & Session Security
JWT_SECRET=replace_with_a_super_secret_64_character_random_key_in_production
SESSION_COOKIE_NAME=aurelia_admin_token
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

